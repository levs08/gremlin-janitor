# Never commit a real Discord bot token.
DISCORD_BOT_TOKEN=put_your_bot_token_here

# Right-click the target Discord channel -> Copy Channel ID.
TARGET_CHANNEL_ID=123456789012345678

# Start in observe mode. Nothing is deleted.
MODE=observe

PLACEHOLDER_TEXT=Sent a message to guild chat but has not yet linked their Discord account.

# SAFETY GUARD: prefer stable source IDs discovered during observation.
SOURCE_AUTHOR_IDS=
SOURCE_WEBHOOK_IDS=
SOURCE_APPLICATION_IDS=

# Leave false unless no stable source signature is available and you deliberately
# choose exact-text-only cleanup in this one dedicated integration channel.
ALLOW_TEXT_ONLY_DELETE=false

RAW_REST_INSPECT=true
LOG_ALL_TARGET_MESSAGES=true
LOG_DIR=logs
